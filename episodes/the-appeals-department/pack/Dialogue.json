    },
    {
      "id": "L030",
      "scene": 3,
      "character": "RONALDO",
      "text": "I want a private hearing. Nobody needs to see me bothered. Put the camera a little higher.",
      "words": 17
    },
    {
      "id": "L031",
      "scene": 3,
      "character": "MICAH",
      "text": "England put seven past Croatia. You seen it?",
