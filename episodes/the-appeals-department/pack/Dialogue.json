      "scene": 1,
      "character": "ROY",
      "text": "A football match?",
      "words": 3
    },
    {
      "id": "L003",
      "scene": 1,
      "character": "GARY",
      "text": "An appeals service. Managers, players, anyone. Nineteen ninety-nine and we'll hear your complaint.",
